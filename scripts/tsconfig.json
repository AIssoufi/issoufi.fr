{
  // Type-checks the scripts: JavaScript run by Node.js, typed with JSDoc. The specs stay out,
  // since they pass bad values on purpose. The DOM types cover the functions that the scripts of
  // the Open Graph image and of the CV run in Chromium.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.mjs"]
}
