{
  "name": "issoufi-v3",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "dependencies": {
    "@xstyled/styled-components": "4.1.1",
    "i18next": "^26.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.0.11",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "build:standalone": "tsc -b && vite build --config vite.standalone.config.ts --configLoader native",
    "size": "node scripts/ci/check-bundle-size.mjs",
    "smoke-test": "node scripts/ci/smoke-test.mjs",
    "og-image": "node scripts/og-image/generate-og-image.mjs",
    "icons": "node scripts/icons/generate-icons.mjs",
    "cv": "node scripts/cv/generate-cv.mjs",
    "cv:check": "node scripts/cv/generate-cv.mjs --check",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc -b && tsc --project scripts",
    "lint": "eslint .",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "test:coverage": "vitest run --coverage --configLoader native",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0",
    "**/*": "prettier --write --ignore-unknown"
  }
}
