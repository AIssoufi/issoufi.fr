{
  "name": "issoufi-v3",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "dependencies": {
    "@xstyled/styled-components": "4.1.1",
    "i18next": "^25.10.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6",
    "react-router": "^8.4.0",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.0.11",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "3.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:standalone": "tsc && vite build --config vite.standalone.config.ts",
    "size": "node scripts/ci/check-bundle-size.mjs",
    "smoke-test": "node scripts/ci/smoke-test.mjs",
    "og-image": "node scripts/og-image/generate-og-image.mjs",
    "cv": "node scripts/cv/generate-cv.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project scripts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0",
    "**/*": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
